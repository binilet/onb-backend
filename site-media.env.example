# Merge these entries into backend/app/.env. Do not replace existing auth settings.
# Local development: both apps must select the same database.
MONGODB_URL=mongodb://localhost:27017/?replicaSet=rs0
MONGODB_NAME=onbingo
IS_PRODUCTION=false
MEDIA_ROOT=media
MEDIA_BASE_URL=http://localhost:8000/media

# Production alternatives:
# MONGODB_URL=mongodb+srv://<user>:<password>@<cluster>/?retryWrites=true&w=majority
# MONGODB_NAME=<shared-production-database>
# IS_PRODUCTION=true
# MEDIA_ROOT=/var/www/hagere-media
# MEDIA_BASE_URL=https://hagere-online.com/media
# bingo-server MONGO_URI must use the SAME cluster and /<shared-production-database>.
